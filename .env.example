# Create a real .env file and replace these placeholders.
BOT_TOKEN=replace_with_botfather_token
ALLOWED_USER_IDS=123456789

# Optional Instagram follower enrichment. Disabled unless explicitly enabled.
INSTAGRAM_ENRICHMENT_ENABLED=false
INSTAGRAM_ENRICHMENT_PROVIDER=meta_graph
INSTAGRAM_ENRICHMENT_API_KEY=
INSTAGRAM_ENRICHMENT_ACCOUNT_ID=
INSTAGRAM_GRAPH_API_VERSION=v21.0
INSTAGRAM_ENRICHMENT_TIMEOUT_SECONDS=3
INSTAGRAM_ENRICHMENT_MAX_CONCURRENCY=3
INSTAGRAM_ENRICHMENT_CACHE_TTL_SECONDS=86400
# Empty means: use the operating system temporary directory.
INSTAGRAM_ENRICHMENT_CACHE_PATH=
